# main.ko — test harness for the DPLL solver.
# Small handcrafted formulas plus generated graph-coloring instances:
# K3 is 2-colorable? No. 3-colorable? Yes. K4 3-colorable? No (needs 4).
#
# NOTE: test labels are printed inline, never passed as arguments —
# println of a String parameter is broken (issue #53).

import sat.{Sat, Unsat}
import sat
import std.List

fn showSat m c f nvars =
  println "SAT"
  println (sat.showModel m 1 nvars)
  println c
  println (sat.verify m f)

fn showUnsat c =
  println "UNSAT"
  println c

fn showOutcome out f nvars = match out
  | Sat m c => showSat m c f nvars
  | Unsat c => showUnsat c

fn run f nvars =
  println (sat.countClauses f)
  showOutcome (sat.solve f) f nvars

fn main =
  # 1. single unit clause: SAT, model [x1]
  println "t1 unit"
  run (1 :: 0 :: Nil) 1
  # 2. direct contradiction: UNSAT
  println "t2 contra"
  run (1 :: 0 :: -1 :: 0 :: Nil) 1
  # 3. (x1|x2) & (~x1|x3) & (~x2|~x3): SAT
  println "t3 small"
  run (1 :: 2 :: 0 :: -1 :: 3 :: 0 :: -2 :: -3 :: 0 :: Nil) 3
  # 4. pigeonhole: 3 pigeons, 2 holes — UNSAT
  # vars x11=1 x12=2 x21=3 x22=4 x31=5 x32=6
  println "t4 php32"
  run (1 :: 2 :: 0 :: 3 :: 4 :: 0 :: 5 :: 6 :: 0 :: -1 :: -3 :: 0 :: -1 :: -5 :: 0 :: -3 :: -5 :: 0 :: -2 :: -4 :: 0 :: -2 :: -6 :: 0 :: -4 :: -6 :: 0 :: Nil) 6
  # 5. triangle, 2 colors — UNSAT (odd cycle is not bipartite)
  println "t5 k3c2"
  run (sat.kcolorComplete 3 2) 6
  # 6. triangle, 3 colors — SAT
  println "t6 k3c3"
  run (sat.kcolorComplete 3 3) 9
  # 7. K4, 3 colors — UNSAT (needs real search)
  println "t7 k4c3"
  run (sat.kcolorComplete 4 3) 12
