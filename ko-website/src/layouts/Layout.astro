---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A minimal, functional-first programming language that compiles to native binaries via LLVM.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Kō</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.classList.add(theme);
      })();
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="container nav-container">
        <a href="/" class="logo">kō</a>
        <div class="nav-links">
          <a href="/docs/tutorial">Docs</a>
          <a href="/docs/reference">Reference</a>
          <a href="/docs/handbook">Handbook</a>
          <a href="https://github.com/Adjanour/ko-language">GitHub</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
            <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>Kō is MIT licensed. Built with Zig and LLVM.</p>
      </div>
    </footer>
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        html.classList.remove('dark', 'light');
        html.classList.add(isDark ? 'light' : 'dark');
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #09090b;
    --bg-card: #111113;
    --bg-code: #0c0c0e;
    --text: #fafafa;
    --text-muted: #a1a1aa;
    --accent: #7c3aed;
    --accent-hover: #6d28d9;
    --border: #1f1f23;
    --radius: 8px;
  }

  html.light {
    --bg: #fafafa;
    --bg-card: #f4f4f5;
    --bg-code: #f0f0f2;
    --text: #18181b;
    --text-muted: #52525b;
    --accent: #7c3aed;
    --accent-hover: #6d28d9;
    --border: #e4e4e7;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    overflow-x: hidden;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    width: 100%;
  }

  main {
    flex: 1;
    overflow-x: hidden;
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    overflow: hidden;
  }

  /* Navbar */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg), transparent 14%);
    backdrop-filter: blur(12px);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .nav-links a {
    padding: 0.375rem 0.625rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: 6px;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    margin-left: 0.5rem;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: none;
  }

  html.dark .sun-icon {
    display: block;
  }

  html.light .moon-icon {
    display: block;
  }

  /* Footer */
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* Typography */
  h1, h2, h3, h4 {
    line-height: 1.2;
    font-weight: 600;
  }

  p {
    color: var(--text-muted);
  }

  a {
    color: var(--accent);
  }

  code {
    font-family: 'JetBrains Mono', monospace;
    background: var(--bg-code);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }

  pre {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1rem 0;
    max-width: 100%;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: 0.9rem;
    color: var(--text);
    white-space: pre;
  }

  /* Code blocks */
  .astro-code {
    background: var(--bg-code) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1rem 0;
    max-width: 100%;
  }

  html.light .astro-code {
    background: #f6f8fa !important;
    border-color: #e4e4e7;
  }

  .astro-code *,
  .astro-code span,
  .astro-code .line {
    background-color: transparent !important;
  }

  html.dark .astro-code span {
    color: #fff !important;
  }

  html.dark .astro-code span[style*="color:#D73A49"] {
    color: #F97583 !important;
  }

  html.dark .astro-code span[style*="color:#005CC5"] {
    color: #79B8FF !important;
  }

  html.dark .astro-code span[style*="color:#032F62"] {
    color: #9ECBFF !important;
  }

  html.dark .astro-code span[style*="color:#6F42C1"] {
    color: #B392F0 !important;
  }

  html.dark .astro-code span[style*="color:#6A737D"] {
    color: #8B949E !important;
  }

  html.dark .astro-code span[style*="color:#24292E"] {
    color: #fff !important;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    display: block;
    overflow-x: auto;
  }

  th, td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }

  th {
    background: var(--bg-card);
    font-weight: 600;
    color: var(--text);
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
  }
</style>
