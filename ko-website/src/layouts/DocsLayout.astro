---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="docs-layout container">
    <aside class="docs-sidebar">
      <nav>
        <div class="nav-section">
          <h4>Getting Started</h4>
          <a href="/docs/install">Install</a>
          <a href="/docs/tutorial">Tutorial</a>
          <a href="/docs/writing-ko-programs">Writing Kō Programs</a>
        </div>
        <div class="nav-section">
          <h4>Language</h4>
          <a href="/docs/reference">Reference</a>
          <a href="/docs/grammar">Grammar</a>
          <a href="/docs/modules">Modules &amp; Imports</a>
          <a href="/docs/linearity-and-ownership">Linearity &amp; Ownership</a>
          <a href="/docs/memory-management">Memory Management</a>
        </div>
        <div class="nav-section">
          <h4>Reference</h4>
          <a href="/docs/error-messages">Error Messages</a>
          <a href="/docs/compiler-pipeline">Compiler Pipeline</a>
        </div>
        <div class="nav-section">
          <h4>Internals</h4>
          <a href="/docs/handbook">Handbook</a>
          <a href="/docs/codegen">Codegen</a>
        </div>
        <div class="nav-section">
          <h4>Project</h4>
          <a href="/docs/roadmap">Roadmap</a>
          <a href="/docs/philosophy">Philosophy</a>
          <a href="/docs/contributing">Contributing</a>
          <a href="/docs/changelog">Changelog</a>
        </div>
        <div class="nav-section">
          <h4>Blog</h4>
          <a href="/docs/build-a-grade-book">Install Kō &amp; Build Your First Program</a>
        </div>
      </nav>
    </aside>
    <article class="docs-content">
      <slot />
    </article>
  </div>
</Layout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 4rem;
    min-height: calc(100vh - 200px);
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
    height: fit-content;
  }

  .nav-section {
    margin-bottom: 1.5rem;
  }

  .nav-section h4 {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    padding-left: 0.75rem;
  }

  .nav-section a {
    display: block;
    padding: 0.35rem 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    border-radius: 6px;
    transition: all 0.15s;
  }

  .nav-section a:hover {
    color: var(--text);
    background: var(--bg-card);
  }

  .docs-content {
    max-width: 720px;
    min-width: 0;
  }

  .docs-content :global(h1) {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .docs-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .docs-content :global(h3) {
    font-size: 1.2rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .docs-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .docs-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    background: var(--bg-code);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .docs-content :global(pre) {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .docs-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.9rem;
    color: var(--text);
  }

  .docs-content :global(.astro-code) {
    background: var(--bg-code) !important;
    border-color: var(--border);
  }

  html.light .docs-content :global(.astro-code) {
    background: #f6f8fa !important;
    border-color: #e4e4e7;
  }

  html.light .docs-content :global(code) {
    background: #f0f0f2;
    color: var(--text);
  }

  .docs-content :global(.astro-code *),
  .docs-content :global(.astro-code span),
  .docs-content :global(.astro-code .line) {
    background-color: transparent !important;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    color: var(--text-muted);
  }

  .docs-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .docs-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
  }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .docs-content :global(th),
  .docs-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .docs-content :global(th) {
    background: var(--bg-card);
    font-weight: 600;
    color: var(--text);
  }

  .docs-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: static;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .docs-sidebar::-webkit-scrollbar {
      display: none;
    }

    .docs-sidebar nav {
      display: flex;
      gap: 0.25rem;
      min-width: max-content;
    }

    .nav-section {
      flex-shrink: 0;
      margin-bottom: 0;
      margin-right: 0.5rem;
    }

    .nav-section h4 {
      font-size: 0.6rem;
      padding: 0.25rem 0.5rem;
      margin-bottom: 0.25rem;
    }

    .nav-section a {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      white-space: nowrap;
    }
  }
</style>
