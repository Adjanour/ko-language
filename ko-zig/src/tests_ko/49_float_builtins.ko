# Float builtins test

fn main =
  # Sign of positive number
  let s1 = Float.sign 3.14
  println s1

  # Sign of negative number
  let s2 = Float.sign (-2.5)
  println s2

  # Sign of zero
  let s3 = Float.sign 0.0
  println s3

  # Predicates
  let nan_result = Float.isNaN (0.0 / 0.0)
  println nan_result

  let inf_result = Float.isInfinite (1.0 / 0.0)
  println inf_result

  let finite_result = Float.isFinite 42.0
  println finite_result

  # Math functions
  let sq = Float.sqrt 4.0
  println sq

  let ab = Float.abs (-7.5)
  println ab

  let fl = Float.floor 2.7
  println fl

  let ce = Float.ceil 2.3
  println ce

  # Constants
  println Float.pi
  println Float.e
  println Float.infinity

  # Type conversion
  let i1 = Float.toInt 3.9
  println i1

  let f1 = Float.ofInt 7
  println f1
