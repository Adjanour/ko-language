fn main =
  println (Result.unwrapOr 0 (Int.addChecked 10 20))
  println (Result.is_ok (Int.addChecked 9223372036854775807 1))
  println (Result.unwrapOr 0 (Int.subChecked 50 20))
  println (Result.is_ok (Int.subChecked (-5000000000000000000) 5000000000000000001))
  println (Result.unwrapOr 0 (Int.mulChecked 6 7))
  println (Result.is_ok (Int.mulChecked 9223372036854775807 2))
  println (Result.unwrapOr 0 (Int.divChecked 20 4))
  println (Result.is_ok (Int.divChecked 20 0))
  println (Result.unwrapOr 0 (Int.modChecked 17 5))
  println (Result.is_ok (Int.modChecked 17 0))
  println (Result.unwrapOr 0 (Int.negChecked 42))
  println (Int.divOr 20 4 0)
  println (Int.divOr 20 0 99)
